# Normalize line endings across Windows + macOS so scripts run on both.
* text=auto

# Bash scripts MUST be LF — CRLF breaks the shebang and `\r` on macOS/Linux.
*.sh   text eol=lf

# Python and Jupyter notebooks: LF everywhere.
*.py    text eol=lf
*.ipynb text eol=lf

# PowerShell is Windows-side; CRLF is conventional there.
*.ps1  text eol=crlf

# Shared tokenizer artifacts are checked out byte-identical on every platform. They are
# generated JSON, not source: nobody hand-edits them, diffs of them are meaningless, and
# rewriting 79k line endings on a 1.1 MB file at every checkout is pure churn. (The vocabulary
# fingerprint hashes the parsed token-to-id map, so line endings could never move it -- this is
# about keeping the artifact stable, not about correctness.)
src/a2-nlp/tokenizers/**/*.json -text
